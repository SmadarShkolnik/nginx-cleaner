# Pinned inputs for build.sh. Every download is checked against the hash here.

# Base image digest (debian:bookworm-slim, OCI index covering amd64 + arm64/v8).
# Pinned for reproducibility: both build/Dockerfile and the Containerfile must use
# this exact FROM ...@DEBIAN_BASE_DIGEST. Resolved 2026-10-16 from Docker Hub.
# To refresh: docker buildx imagetools inspect debian:bookworm-slim (or the
# registry manifests HEAD) and update the digest in all three places together.
DEBIAN_BASE_DIGEST=sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

# nginx.org packaging (pkg-oss). Commit 14d7f18 = nginx 1.25.5 + njs 0.8.4 release 3,
# the exact package set shipped in nginx:1.25-bookworm.
PKG_OSS_REPO=https://github.com/nginx/pkg-oss.git
PKG_OSS_COMMIT=14d7f1843e9ab69df6d36c3057a0a886f3813ccd
NGINX_VERSION=1.25.5
NJS_VERSION=0.8.4
# nginx source tarball (nginx.org). Used only by the ASan diagnostic (build/asan.sh);
# the shipped .debs fetch nginx via pkg-oss, which checks its own SHA512SUMS.
NGINX_SRC_SHA256=2fe2294f8af4144e7e842eaea884182a84ee7970e11046ba98194400902bbec0

# Our release suffix. Appended to the upstream package release (1 -> 1+echo1).
ECHO_SUFFIX=+echo1

# njs: the hg.nginx.org archive pkg-oss points to is gone; use the GitHub tag archive (same njs-0.8.4/ tree).
NJS_URL=https://github.com/nginx/njs/archive/refs/tags/0.8.4.tar.gz
NJS_SHA512=450f6866141f6f370767149c8749e84c4373f401d6d2237ca85365a851ebe7bdbd8a3c25e85a55747673e8bef2238a979dd237d5fc5c641b2f3f2cf7f26dffc8

# xslscript (pkg-oss changelog tool): same move to GitHub; version + hash from pkg-oss master.
XSLSCRIPT_VERSION=9204424259c343ca08a18a78915f40f28025e093
XSLSCRIPT_SHA512=e4b6ee26c4f7264e0cff9fcbf67ffd9f0029abad3818874a1bee6786f52fb1c6c8759d92b87bcc25c7bc330d970adcfcef69ee928c22f433fe735021cbc7e954

# OpenSSL version bump: 3.0.11 (in nginx:1.25-bookworm) -> 3.0.22 (upstream).
OPENSSL_VERSION=3.0.22
OPENSSL_URL=https://github.com/openssl/openssl/releases/download/openssl-3.0.22/openssl-3.0.22.tar.gz
OPENSSL_SHA256=67ebca7e50d17383028045486653492195b83db95f8558709701bb47b5c1ef81
# Debian packaging (debian/ dir only) for the same upstream version, from bookworm-security.
OPENSSL_DEBIAN_URL=https://deb.debian.org/debian-security/pool/updates/main/o/openssl/openssl_3.0.22-1~deb12u1.debian.tar.xz
OPENSSL_DEBIAN_SHA256=08ee68527218d6d9a0fa4741ec8ffef47646cdcad0ed0822b84bf11677c66108
OPENSSL_DEB_VERSION=3.0.22-1~deb12u1+echo1
